{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IEM-PM Canonical Findings v1.4.0",
  "description": "Machine-readable single source of truth for PMO Data Gap Audit",
  "type": "object",
  "definitions": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,10}(-[A-Za-z0-9]{1,10}){1,3}$",
      "description": "Any Charter-declared PREFIX-SUFFIX ID scheme (ART-001, WK8-01, DOC-2026-08, ...), not just the illustrative ART-NNN in the templates. One shared definition so both usages below can't drift apart."
    }
  },
  "required": [
    "audit_id",
    "schema_version",
    "charter_version",
    "skill_version",
    "model",
    "generated_at",
    "baseline",
    "evidence_summary",
    "findings",
    "intelligence_indicators",
    "reporting_integrity_score"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "pattern": "^IEM-[0-9]{8}-[A-Z0-9]{6}$",
      "description": "Unique audit run identifier: IEM-YYYYMMDD-XXXXXX"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.4.0"]
    },
    "charter_version": {
      "type": "string",
      "description": "Version of PMO Data Charter used"
    },
    "skill_version": {
      "type": "string",
      "description": "v1.4.0: the intelligence-engine SKILL.md version that produced this audit. Provenance, not a scoring input -- lets two audits of the same evidence be compared knowing whether a difference in findings is a real inconsistency or just two different skill versions. Falls back to 'unknown' if the Manifest header doesn't state it; never blocks the audit."
    },
    "model": {
      "type": "string",
      "description": "v1.4.0: the AI model that produced this audit, as it stated about itself. Same provenance rationale as skill_version. Falls back to 'unknown' if the Manifest header doesn't state it; never blocks the audit."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when canonical JSON was generated"
    },
    "baseline": {
      "type": "object",
      "required": ["standards_declared", "artifacts_examined", "scope"],
      "properties": {
        "standards_declared": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "List of standards org claims to follow"
        },
        "artifacts_examined": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_id", "artifact_name", "source_path", "checksum"],
            "properties": {
              "artifact_id": { "$ref": "#/definitions/artifact_id" },
              "artifact_name": { "type": "string" },
              "source_path": { "type": "string" },
              "checksum": {
                "type": "string",
                "description": "SHA-256 of artifact at time of audit, or 'computed'"
              }
            }
          }
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Audit scope: Projects, Programs, Portfolios, PMO"
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": ["total_artifacts", "total_fields_mapped", "coverage_percentage"],
      "properties": {
        "total_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "total_fields_mapped": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gap_type",
          "root_origin",
          "description",
          "evidence",
          "standard_reference",
          "severity",
          "impact",
          "recommended_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FIND-[0-9]{4}$"
          },
          "gap_type": {
            "type": "string",
            "enum": [
              "Missing",
              "Ignored",
              "Disconnected",
              "Untrusted",
              "Underutilized",
              "Misclassified",
              "Divergent"
            ]
          },
          "root_origin": {
            "type": "string",
            "enum": [
              "Capture",
              "Integration",
              "Definition / Taxonomy",
              "Ownership",
              "Process / Cadence",
              "Tooling",
              "Behavior"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "description": "What was found and why it matters"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["artifact_id", "location", "quote_or_absence"],
              "properties": {
                "artifact_id": { "$ref": "#/definitions/artifact_id" },
                "location": {
                  "type": "string",
                  "description": "Sheet name, page, line, or cell reference"
                },
                "quote_or_absence": {
                  "type": "string",
                  "description": "Direct quote from artifact, or explicit statement of absence"
                }
              }
            }
          },
          "standard_reference": {
            "type": "object",
            "required": ["standard", "identifier"],
            "properties": {
              "standard": {
                "type": "string",
                "description": "e.g., PMBOK7, PRINCE2, Internal-PMM-v2"
              },
              "clause": {
                "type": "string",
                "description": "Clause or section reference"
              },
              "identifier": {
                "type": "string",
                "description": "Specific process ID or practice ID"
              },
              "summary": {
                "type": "string",
                "description": "Brief summary of requirement (never full text)"
              }
            }
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1=Cosmetic, 5=Critical delivery threat"
          },
          "human_approved": {
            "type": ["boolean", "null"],
            "description": "v1.2.0: required True for Severity 4 (Major) and 5 (Critical) findings -- enforced by schema.py's validate_major_finding_approval(), not by this JSON-schema field alone, since jsonschema has no clean way to conditionally require a field only when another field crosses a threshold. Null/absent is valid for Severity 1-3."
          },
          "human_approved_by": {
            "type": ["string", "null"],
            "description": "v1.3.0: name/role of the human who gave the approval recorded in human_approved. Required whenever human_approved is true -- enforced by schema.py's validate_major_finding_approval(), same reasoning as human_approved itself. A bare 'Approved' boolean with no accountable name is a flag, not an audit trail."
          },
          "human_approved_at": {
            "type": ["string", "null"],
            "description": "v1.3.0: when the approval in human_approved was given, as stated by the approver (free text -- not required to be a machine-parseable timestamp, since approvals often happen conversationally, not against a clock). Required whenever human_approved is true."
          },
          "impact": {
            "type": "string",
            "description": "Narrative impact on delivery capability"
          },
          "recommended_action": {
            "type": "string"
          },
          "intelligence_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Visibility",
                "Integrity",
                "Connectivity",
                "Governance",
                "Predictability",
                "Decision Quality",
                "Continuous Improvement"
              ]
            },
            "description": "Which intelligence dimensions this finding affects"
          }
        }
      }
    },
    "intelligence_indicators": {
      "type": "object",
      "description": "Narrative diagnostic labels only. Never scored or weighted here.",
      "required": [
        "visibility",
        "integrity",
        "connectivity",
        "governance",
        "predictability",
        "decision_quality",
        "continuous_improvement"
      ],
      "properties": {
        "visibility": { "type": "string" },
        "integrity": { "type": "string" },
        "connectivity": { "type": "string" },
        "governance": { "type": "string" },
        "predictability": { "type": "string" },
        "decision_quality": { "type": "string" },
        "continuous_improvement": { "type": "string" }
      }
    },
    "reporting_integrity_score": {
      "type": "object",
      "required": ["score", "methodology", "version"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Deterministic score based on gap profile"
        },
        "methodology": { "type": "string" },
        "version": { "type": "string" },
        "components": {
          "type": "object",
          "description": "v1.2.0: transparent breakdown of every deduction that produced the score -- added so the number is auditable, not just asserted.",
          "properties": {
            "severity_deduction": { "type": "number" },
            "density_deduction": { "type": "number" },
            "diversity_deduction": { "type": "number" },
            "missing_deduction": { "type": "number" },
            "total_findings": { "type": "integer" },
            "total_artifacts": { "type": "integer" },
            "unique_origins": { "type": "integer" }
          }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "v1.2.0: explicit, standing caveats about what this score does and does not establish -- rendered into every report, not left implicit."
        }
      }
    }
  }
}